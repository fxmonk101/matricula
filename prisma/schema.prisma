// =============================================================================
// Multi-tenant School Platform — Data Model
// =============================================================================
// Portability note: this schema deliberately avoids SQLite-only and
// Postgres-only features. Enumerations are modelled as String columns whose
// legal values are enforced by Zod at the application boundary
// (see src/lib/domain/enums.ts). This keeps `provider` a one-line change:
//
//   provider = "sqlite"      -> local development, zero setup
//   provider = "postgresql"  -> production
//
// Monetary amounts are stored as INTEGER minor units (kobo/cents). Never float.
//
// -----------------------------------------------------------------------------
// TENANCY
// -----------------------------------------------------------------------------
// Every model below is either PLATFORM-OWNED or TENANT-OWNED.
//
//   Platform-owned: School, SchoolConfig, User, PlatformAdmin, Membership,
//                   IdentityProvider, AuditLog (schoolId nullable).
//   Tenant-owned:   everything else. Each carries a NON-NULL `schoolId`.
//
// `schoolId` is deliberately NOT NULL on tenant models. That is a security
// property, not a data-modelling preference: if the tenant-scoping layer in
// src/lib/tenant.ts ever fails to inject it, the write fails on a NOT NULL
// violation rather than silently landing an unscoped row that every tenant
// can then read.
//
// Identity is GLOBAL (User.email is globally unique); authorisation is
// PER-TENANT (Membership carries the role). One person, many schools — which
// is what makes a consultant teacher, an examiner, or a guardian with children
// at two schools expressible without a re-migration later.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

/// A school. The tenant boundary for every tenant-owned row in the system.
model School {
  id        String @id @default(cuid())
  /// URL path segment: /s/<slug>/login. Also the subdomain when that mode is on.
  slug      String @unique
  /// Short prefix stamped into human-quotable document numbers so that
  /// INV-GEU-2025-000001 and INV-MIT-2025-000001 can never be confused.
  code      String @unique
  name      String
  shortName String

  /// AcademicModel: HIGHER_ED | K12
  /// Selects which academic engines and vocabulary apply. K12 support lands in
  /// its own phase; the column exists now so the switch is never a migration.
  academicModel String @default("HIGHER_ED")

  /// SchoolStatus: ACTIVE | TRIAL | SUSPENDED | PROVISIONING
  status String  @default("PROVISIONING")
  /// Entitlement tier; drives feature flags later.
  plan   String?

  country      String?
  locale       String  @default("en-NG")
  timezone     String  @default("Africa/Lagos")
  currencyCode String  @default("NGN")

  brandColor    String  @default("#1b5df5")
  logoUrl       String?
  primaryDomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config            SchoolConfig?
  memberships       Membership[]
  orgUnits          OrgUnit[]
  identityProviders IdentityProvider[]
  tasks             Task[]
  notifications     Notification[]
  forums            Forum[]
  libraryResources  LibraryResource[]
  collections       ResourceCollection[]

  @@index([status])
  @@map("schools")
}

/// Per-school policy. Each column is a JSON document validated by Zod on write
/// (see src/lib/domain/config.ts, added in the configuration phase).
///
/// Modelled as String rather than Prisma `Json` because `Json` is not portable
/// to SQLite — the same reason AuditLog.metadata is a String today.
model SchoolConfig {
  id       String @id @default(cuid())
  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Grade bands, assessment weights, standing thresholds, degree classes.
  gradingJson            String
  /// Credit ceilings, registration tolerances.
  enrollmentJson         String
  /// Rubric weights, decision thresholds, offer validity.
  admissionsJson         String
  /// Currency, refund schedule, financial-hold policy.
  financeJson            String
  /// Institution name, logo, colour, per-role landing overrides.
  brandingJson           String
  /// Locale, timezone, week start, date format.
  localeJson             String
  /// Which fields the public application form collects, which programs are open.
  registrationPortalJson String
  /// K-12 policy: promotion thresholds, behaviour traits, report-card settings.
  /// Nullable because a higher-education school never reads it.
  k12Json                String?

  updatedAt DateTime @updatedAt

  @@map("school_configs")
}

/// A person's membership of one school, carrying their role there.
///
/// Role lives HERE, not on User: the same human can be an instructor at one
/// school and a guardian at another, and neither fact should be able to
/// authorise them at the other.
model Membership {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Role: ADMIN | REGISTRAR | FINANCE | ADMISSIONS | INSTRUCTOR | STUDENT | APPLICANT | LIBRARIAN | STAFF | GUARDIAN
  role  String
  title String?

  orgUnitId String?
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  /// Reporting line, within the same school. Dean <- HOD <- Lecturer.
  managerId String?
  manager   Membership?  @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports   Membership[] @relation("Reports")

  /// The school this person lands in by default when they sign in.
  isPrimary Boolean @default(true)
  /// MembershipStatus: ACTIVE | INVITED | SUSPENDED
  status    String  @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- collaboration (Phase 3) ---
  assignedTasks Task[]         @relation("TaskAssignee")
  raisedTasks   Task[]         @relation("TaskAssigner")
  taskComments  TaskComment[]
  taskEvents    TaskEvent[]
  taskWatching  TaskWatcher[]
  notifications Notification[]

  // --- forums (Phase 4) ---
  threads         Thread[]       @relation("ThreadAuthor")
  posts           Post[]         @relation("PostAuthor")
  reactions       PostReaction[]
  reportsMade     PostReport[]   @relation("ReportReporter")
  reportsResolved PostReport[]   @relation("ReportResolver")

  // --- library (Phase 5) ---
  resourcesAdded     LibraryResource[]    @relation("ResourceAdder")
  collectionsCurated ResourceCollection[] @relation("CollectionCurator")
  resourceViews      ResourceView[]

  @@unique([userId, schoolId])
  @@index([schoolId, role])
  @@index([managerId])
  @@map("memberships")
}

/// Platform operators. Deliberately NOT a Role — a platform admin acts across
/// tenants and must never be expressible in the per-school permission matrix.
model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("platform_admins")
}

/// The school's internal hierarchy: faculties, departments, offices, teams.
/// Generic on purpose so a K-12 school can model sections and year groups in
/// the same tree a university uses for faculties and departments.
model OrgUnit {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  code String
  name String
  /// OrgUnitKind: FACULTY | DEPARTMENT | ADMIN_UNIT | SCHOOL_SECTION | TEAM
  kind String

  parentId String?
  parent   OrgUnit?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgUnit[] @relation("OrgTree")

  /// Membership.id of the unit head, if one is appointed.
  headMembershipId String?

  createdAt DateTime @default(now())

  memberships Membership[]
  tasks       Task[]

  @@unique([schoolId, code])
  @@index([schoolId, parentId])
  @@map("org_units")
}

/// Per-school SSO configuration. Ships unused: no code reads it yet. It exists
/// now so that adding Entra / Google federation later is additive rather than
/// a migration of the identity model.
model IdentityProvider {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// IdpKind: OIDC | SAML | GOOGLE | ENTRA
  kind         String
  displayName  String
  issuer       String?
  clientId     String?
  clientSecret String?
  metadataUrl  String?
  /// Email domains auto-routed to this provider, comma separated.
  emailDomains String?
  isEnabled    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, kind])
  @@map("identity_providers")
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

/// A person. Global — one row per human, whatever schools they belong to.
/// Their role(s) live on Membership.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   Membership[]
  platformAdmin PlatformAdmin?
  students      Student[]
  instructors   Instructor[]
  applicants    Applicant[]
  guardianships Guardian[]
  auditLogs     AuditLog[]

  @@map("users")
}

/// Append-only trail of every state-changing operation. Never updated, never
/// deleted — required for registrarial and financial defensibility.
///
/// `schoolId` is NULLABLE here alone: provisioning a school, or a platform
/// admin acting across tenants, produces a legitimate entry belonging to no
/// single school.
model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // e.g. "enrollment.create", "grade.submit", "payment.record"
  entityType String
  entityId   String
  summary    String
  metadata   String? // JSON blob
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Organisational structure
// -----------------------------------------------------------------------------

model Faculty {
  id        String   @id @default(cuid())
  schoolId  String
  code      String
  name      String
  createdAt DateTime @default(now())

  departments Department[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("faculties")
}

model Department {
  id        String   @id @default(cuid())
  schoolId  String
  code      String
  name      String
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  programs    Program[]
  courses     Course[]
  instructors Instructor[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([facultyId])
  @@map("departments")
}

model Program {
  id                String     @id @default(cuid())
  schoolId          String
  code              String
  name              String
  degreeType        String // DegreeType: BSC | BA | BENG | MSC | MA | PHD | DIPLOMA
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Credits required to graduate.
  creditsRequired   Int        @default(120)
  /// Nominal duration in academic terms.
  durationTerms     Int        @default(8)
  minCgpaToGraduate Float      @default(1.5)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())

  students      Student[]
  applications  Application[]
  requirements  ProgramRequirement[]
  feeStructures FeeStructure[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([departmentId])
  @@map("programs")
}

/// A course that counts toward a program, and in what capacity.
model ProgramRequirement {
  id        String  @id @default(cuid())
  schoolId  String
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// RequirementKind: CORE | ELECTIVE | GENERAL_STUDIES
  kind      String  @default("CORE")
  /// Recommended level of study (100, 200, ...).
  level     Int     @default(100)

  @@unique([programId, courseId])
  @@index([schoolId])
  @@index([courseId])
  @@map("program_requirements")
}

// -----------------------------------------------------------------------------
// Academic calendar
// -----------------------------------------------------------------------------

model Term {
  id                   String   @id @default(cuid())
  schoolId             String
  code                 String // e.g. "2025-FALL"
  name                 String
  academicYear         String // e.g. "2025/2026"
  /// TermSeason: FALL | SPRING | SUMMER
  season               String
  startDate            DateTime
  endDate              DateTime
  /// Registration window — enrollment requests outside it are rejected.
  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  /// Last day a student may drop without a "W" transcript notation.
  addDropDeadline      DateTime
  /// Last day a student may withdraw at all.
  withdrawalDeadline   DateTime
  /// Only one term per school may be current; enforced in application logic.
  isCurrent            Boolean  @default(false)
  createdAt            DateTime @default(now())

  offerings     CourseOffering[]
  invoices      Invoice[]
  termGpas      TermGpa[]
  applications  Application[]
  feeStructures FeeStructure[]

  // K-12 side
  subjectAssignments SubjectAssignment[]
  classEnrolments    ClassEnrolment[]
  attendance         AttendanceRecord[]
  reportCards        ReportCard[]

  @@unique([schoolId, code])
  @@index([schoolId, isCurrent])
  @@map("terms")
}

// -----------------------------------------------------------------------------
// Curriculum
// -----------------------------------------------------------------------------

model Course {
  id           String     @id @default(cuid())
  schoolId     String
  code         String // e.g. "CSC301"
  title        String
  description  String?
  creditHours  Int
  level        Int        @default(100)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  offerings     CourseOffering[]
  requirements  ProgramRequirement[]
  prerequisites Prerequisite[]       @relation("CourseToPrereq")
  requiredBy    Prerequisite[]       @relation("PrereqToCourse")

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([departmentId])
  @@index([level])
  @@map("courses")
}

/// Directed edge in the prerequisite DAG: `course` requires `prerequisite`.
model Prerequisite {
  id             String  @id @default(cuid())
  schoolId       String
  courseId       String
  course         Course  @relation("CourseToPrereq", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteId String
  prerequisite   Course  @relation("PrereqToCourse", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  /// Minimum grade point that must have been earned in the prerequisite.
  minGradePoint  Float   @default(1.0)
  /// CONCURRENT prerequisites may be taken in the same term.
  isConcurrent   Boolean @default(false)

  @@unique([courseId, prerequisiteId])
  @@index([schoolId])
  @@index([prerequisiteId])
  @@map("prerequisites")
}

/// A concrete section of a course taught in a term ("CSC301-A, Fall 2025").
model CourseOffering {
  id               String      @id @default(cuid())
  schoolId         String
  courseId         String
  course           Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  termId           String
  term             Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  section          String      @default("A")
  instructorId     String?
  instructor       Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  capacity         Int         @default(50)
  /// Denormalised counter kept consistent inside the enrollment transaction.
  /// Source of truth remains COUNT(enrollments WHERE status IN (REGISTERED)).
  seatsTaken       Int         @default(0)
  waitlistCapacity Int         @default(10)
  room             String?
  /// OfferingStatus: PLANNED | OPEN | CLOSED | CANCELLED
  status           String      @default("OPEN")
  /// True once the instructor has submitted final grades.
  gradesPosted     Boolean     @default(false)
  createdAt        DateTime    @default(now())

  meetings    Meeting[]
  enrollments Enrollment[]

  @@unique([courseId, termId, section])
  @@index([schoolId])
  @@index([termId])
  @@index([instructorId])
  @@map("course_offerings")
}

/// One weekly timeslot for an offering. Times are minutes-from-midnight in the
/// school's local timezone, which makes conflict detection pure integer math.
model Meeting {
  id          String         @id @default(cuid())
  schoolId    String
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  /// 1 = Monday ... 7 = Sunday (ISO-8601).
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  room        String?

  @@index([schoolId])
  @@index([offeringId])
  @@index([dayOfWeek])
  @@map("meetings")
}

// -----------------------------------------------------------------------------
// People
// -----------------------------------------------------------------------------

model Student {
  id                String    @id @default(cuid())
  schoolId          String
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricNumber      String
  programId         String
  program           Program   @relation(fields: [programId], references: [id])
  /// Level of study: 100, 200, 300, 400...
  level             Int       @default(100)
  admissionTermCode String?
  dateOfBirth       DateTime?
  gender            String?
  nationality       String?
  address           String?
  /// StudentStatus: ACTIVE | PROBATION | SUSPENDED | WITHDRAWN | GRADUATED | DEFERRED
  status            String    @default("ACTIVE")
  /// AcademicStanding: GOOD | DEANS_LIST | WARNING | PROBATION | DISMISSED
  academicStanding  String    @default("GOOD")
  /// Cached aggregates, recomputed by the GPA engine. Never authoritative.
  cgpa              Float     @default(0)
  creditsEarned     Int       @default(0)
  creditsAttempted  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]
  invoices    Invoice[]
  payments    Payment[]
  termGpas    TermGpa[]
  holds       Hold[]

  // K-12 side
  classEnrolments ClassEnrolment[]
  subjectResults  SubjectResult[]
  attendance      AttendanceRecord[]
  reportCards     ReportCard[]
  guardians       GuardianStudent[]

  @@unique([schoolId, userId])
  @@unique([schoolId, matricNumber])
  @@index([schoolId, status])
  @@index([programId])
  @@map("students")
}

model Instructor {
  id           String     @id @default(cuid())
  schoolId     String
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffNumber  String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  /// AcademicRank: PROFESSOR | ASSOCIATE_PROFESSOR | SENIOR_LECTURER | LECTURER | ASSISTANT_LECTURER
  rank         String     @default("LECTURER")
  officeRoom   String?
  createdAt    DateTime   @default(now())

  offerings          CourseOffering[]
  formClasses        FormClass[]
  subjectAssignments SubjectAssignment[]

  @@unique([schoolId, userId])
  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@index([departmentId])
  @@map("instructors")
}

// -----------------------------------------------------------------------------
// Admissions
// -----------------------------------------------------------------------------

model Applicant {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth DateTime?
  gender      String?
  nationality String?
  address     String?
  createdAt   DateTime  @default(now())

  applications Application[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("applicants")
}

model Application {
  id          String    @id @default(cuid())
  schoolId    String
  referenceNo String // human-quotable, e.g. "APP-GEU-2025-000418"
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  programId   String
  program     Program   @relation(fields: [programId], references: [id])
  termId      String
  term        Term      @relation(fields: [termId], references: [id])

  /// ApplicationStatus lifecycle:
  /// DRAFT -> SUBMITTED -> UNDER_REVIEW -> (OFFERED | WAITLISTED | REJECTED)
  /// OFFERED -> (ACCEPTED -> ENROLLED | DECLINED | EXPIRED)
  /// Any pre-decision state -> WITHDRAWN
  status String @default("DRAFT")

  // --- raw evaluation inputs -------------------------------------------------
  /// Prior academic performance, normalised to a 0-100 scale.
  priorGpaScore        Float?
  /// Standardised entrance exam raw score.
  entranceExamScore    Float?
  /// Rubric-scored personal statement (0-100), averaged across reviewers.
  essayScore           Float?
  /// Rubric-scored interview (0-100), averaged across reviewers.
  interviewScore       Float?
  /// Extracurricular / service rubric (0-100).
  extracurricularScore Float?

  // --- computed by the admissions scoring engine -----------------------------
  /// Weighted composite on a 0-100 scale. Null until scored.
  compositeScore Float?
  /// Rank within (programId, termId) at the moment of the last decision run.
  rankInCohort   Int?

  personalStatement String?
  previousSchool    String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  decisionNote      String?
  /// Deadline for the applicant to accept an offer.
  offerExpiresAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviews   ApplicationReview[]
  documents ApplicationDocument[]

  @@unique([schoolId, referenceNo])
  @@unique([applicantId, programId, termId])
  @@index([schoolId, status])
  @@index([programId, termId, status])
  @@map("applications")
}

model ApplicationReview {
  id                   String      @id @default(cuid())
  schoolId             String
  applicationId        String
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId           String
  /// Rubric sub-scores, each 0-100.
  academicScore        Float
  essayScore           Float
  interviewScore       Float?
  extracurricularScore Float?
  /// Recommendation: ADMIT | WAITLIST | REJECT
  recommendation       String
  comments             String?
  createdAt            DateTime    @default(now())

  @@unique([applicationId, reviewerId])
  @@index([schoolId])
  @@index([applicationId])
  @@map("application_reviews")
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  schoolId      String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// DocumentKind: TRANSCRIPT | ID_CARD | BIRTH_CERTIFICATE | RECOMMENDATION | OTHER
  kind          String
  fileName      String
  fileUrl       String
  verified      Boolean     @default(false)
  uploadedAt    DateTime    @default(now())

  @@index([schoolId])
  @@index([applicationId])
  @@map("application_documents")
}

// -----------------------------------------------------------------------------
// Registration & assessment
// -----------------------------------------------------------------------------

model Enrollment {
  id         String         @id @default(cuid())
  schoolId   String
  studentId  String
  student    Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  /// EnrollmentStatus: REGISTERED | WAITLISTED | DROPPED | WITHDRAWN | COMPLETED
  status           String @default("REGISTERED")
  /// Position in the waitlist queue; null unless WAITLISTED. Monotonic per offering.
  waitlistPosition Int?

  // --- assessment ------------------------------------------------------------
  /// Continuous assessment, 0-40 by institutional policy.
  caScore            Float?
  /// Final examination, 0-60 by institutional policy.
  examScore          Float?
  /// caScore + examScore, 0-100. Materialised for reporting.
  totalScore         Float?
  /// Letter grade derived from totalScore via the grading scale.
  letterGrade        String?
  /// Grade point for the letter grade.
  gradePoint         Float?
  /// True when this attempt is superseded by a later retake (excluded from CGPA
  /// under the "best attempt" policy).
  isRepeatSuperseded Boolean @default(false)

  enrolledAt DateTime  @default(now())
  droppedAt  DateTime?
  gradedAt   DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([studentId, offeringId])
  @@index([schoolId])
  @@index([offeringId, status])
  @@index([studentId, status])
  @@map("enrollments")
}

/// Per-term GPA snapshot. Immutable once the term closes; the audit trail for
/// how a CGPA was arrived at.
model TermGpa {
  id               String   @id @default(cuid())
  schoolId         String
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId           String
  term             Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  creditsAttempted Int
  creditsEarned    Int
  qualityPoints    Float
  gpa              Float
  cumulativeGpa    Float
  academicStanding String
  computedAt       DateTime @default(now())

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([studentId])
  @@map("term_gpas")
}

/// A block placed on a student's record. Any active hold with blocksRegistration
/// prevents enrollment.
model Hold {
  id                 String    @id @default(cuid())
  schoolId           String
  studentId          String
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// HoldKind: FINANCIAL | ACADEMIC | DISCIPLINARY | DOCUMENTATION | HEALTH
  kind               String
  reason             String
  blocksRegistration Boolean   @default(true)
  blocksTranscript   Boolean   @default(false)
  placedBy           String?
  placedAt           DateTime  @default(now())
  releasedAt         DateTime?
  releasedBy         String?

  @@index([schoolId])
  @@index([studentId, releasedAt])
  @@map("holds")
}

// -----------------------------------------------------------------------------
// Finance
// -----------------------------------------------------------------------------
// All amounts are INTEGER minor units. Currency is per-school.

/// The published price list. Assessment resolves the most specific matching
/// structure for a (program, term, level) triple.
model FeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// Null = applies to every program.
  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// Null = applies to every level.
  level     Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items FeeItem[]

  @@index([schoolId])
  @@index([termId, programId, level])
  @@map("fee_structures")
}

model FeeItem {
  id             String       @id @default(cuid())
  schoolId       String
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  code           String // TUITION, LAB, LIBRARY, ACCOMMODATION, ...
  description    String
  /// Minor units. If perCreditHour is true this is the rate per credit hour.
  amountMinor    Int
  perCreditHour  Boolean      @default(false)
  isMandatory    Boolean      @default(true)

  @@index([schoolId])
  @@index([feeStructureId])
  @@map("fee_items")
}

model Invoice {
  id            String    @id @default(cuid())
  schoolId      String
  invoiceNo     String // "INV-GEU-2025-000913"
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId        String
  term          Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// InvoiceStatus: DRAFT | ISSUED | PARTIALLY_PAID | PAID | OVERDUE | VOID
  status        String    @default("ISSUED")
  /// Sum of line items, minor units.
  subtotalMinor Int       @default(0)
  /// Scholarships, bursaries, sibling discounts — stored positive, subtracted.
  discountMinor Int       @default(0)
  /// subtotal - discount. The amount actually owed.
  totalMinor    Int       @default(0)
  /// Sum of allocations from payments. Maintained transactionally.
  paidMinor     Int       @default(0)
  issuedAt      DateTime  @default(now())
  dueDate       DateTime
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([schoolId, invoiceNo])
  @@unique([studentId, termId])
  @@index([schoolId, status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id              String  @id @default(cuid())
  schoolId        String
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  code            String
  description     String
  quantity        Int     @default(1)
  unitAmountMinor Int
  /// quantity * unitAmountMinor
  amountMinor     Int

  @@index([schoolId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id             String   @id @default(cuid())
  schoolId       String
  receiptNo      String // "RCP-GEU-2025-004411"
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountMinor    Int
  /// PaymentMethod: CARD | BANK_TRANSFER | CASH | CHEQUE | SCHOLARSHIP | WAIVER
  method         String
  /// PaymentStatus: PENDING | CONFIRMED | FAILED | REVERSED
  status         String   @default("CONFIRMED")
  /// Provider reference; unique per school to make webhooks idempotent.
  externalRef    String?
  note           String?
  /// Portion not yet applied to any invoice (student credit balance).
  unappliedMinor Int      @default(0)
  receivedAt     DateTime @default(now())
  recordedBy     String?
  createdAt      DateTime @default(now())

  allocations PaymentAllocation[]

  @@unique([schoolId, receiptNo])
  @@unique([schoolId, externalRef])
  @@index([schoolId, studentId, receivedAt])
  @@map("payments")
}

/// Explicit many-to-many between payments and invoices. A payment may settle
/// several invoices; an invoice may be settled by several payments. This table
/// is what makes the ledger reconstructable.
model PaymentAllocation {
  id          String   @id @default(cuid())
  schoolId    String
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinor Int
  createdAt   DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([schoolId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// -----------------------------------------------------------------------------
// Communications
// -----------------------------------------------------------------------------

model Announcement {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  body        String
  /// Comma-separated roles this is visible to; empty = everyone.
  audience    String    @default("")
  /// Severity: INFO | WARNING | URGENT
  severity    String    @default("INFO")
  authorId    String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  @@index([schoolId, publishedAt])
  @@map("announcements")
}

// =============================================================================
// K-12 ACADEMIC MODEL
// =============================================================================
// A primary or secondary school is not a small university, and modelling it as
// one is how school systems become unusable for both. The differences are
// structural, not cosmetic:
//
//   Higher education             K-12
//   ----------------             ----
//   Faculty -> Dept -> Program   School section -> Year group -> Form class
//   Course with credit hours     Subject, no credits
//   Student registers per        Pupil is assigned to a form class; the
//     section, building a load      subjects follow automatically
//   CA + exam -> GPA / CGPA      CA + exam -> subject grade, class position
//   Transcript, classification   Termly report card, promotion decision
//   Matriculation number         Admission number
//   Guardians rare               Guardians are core
//
// `School.academicModel` selects which set applies. The two live side by side
// rather than one being bent into the other, so neither is compromised.
// =============================================================================

/// A year of study: Year 7, Grade 4, JSS 1. Ordered by `sequence`, which is
/// also what promotion walks up.
model YearGroup {
  id         String   @id @default(cuid())
  schoolId   String
  code       String // "Y7"
  name       String // "Year 7"
  /// Ordering key. Promotion moves a pupil from `sequence` to `sequence + 1`.
  sequence   Int
  /// True for the final year — pupils here graduate rather than being promoted.
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())

  formClasses FormClass[]
  subjects    Subject[]

  @@unique([schoolId, code])
  @@index([schoolId, sequence])
  @@map("year_groups")
}

/// A form/homeroom class: "Year 7 — Blue". The unit a pupil belongs to.
model FormClass {
  id            String      @id @default(cuid())
  schoolId      String
  yearGroupId   String
  yearGroup     YearGroup   @relation(fields: [yearGroupId], references: [id], onDelete: Cascade)
  code          String // "7B"
  name          String // "Year 7 — Blue"
  /// The form teacher, who writes the termly remark.
  formTeacherId String?
  formTeacher   Instructor? @relation(fields: [formTeacherId], references: [id], onDelete: SetNull)
  capacity      Int         @default(30)
  createdAt     DateTime    @default(now())

  enrolments  ClassEnrolment[]
  assignments SubjectAssignment[]

  @@unique([schoolId, code])
  @@index([schoolId, yearGroupId])
  @@map("form_classes")
}

/// A subject taught to a year group. No credit hours — a K-12 subject is not
/// weighted, so a termly average is a plain mean rather than a credit-weighted
/// one. That is the single biggest arithmetic difference from the degree side.
model Subject {
  id          String     @id @default(cuid())
  schoolId    String
  code        String
  name        String
  description String?
  yearGroupId String?
  yearGroup   YearGroup? @relation(fields: [yearGroupId], references: [id], onDelete: SetNull)
  /// Core subjects appear on every report card for the year group.
  isCore      Boolean    @default(true)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  assignments SubjectAssignment[]

  @@unique([schoolId, code])
  @@index([schoolId, yearGroupId])
  @@map("subjects")
}

/// One subject taught to one form class in one term, by one teacher.
/// The K-12 analogue of CourseOffering.
model SubjectAssignment {
  id          String      @id @default(cuid())
  schoolId    String
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  formClassId String
  formClass   FormClass   @relation(fields: [formClassId], references: [id], onDelete: Cascade)
  termId      String
  term        Term        @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacherId   String?
  teacher     Instructor? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  /// True once marks are final and visible on report cards.
  marksPosted Boolean     @default(false)
  createdAt   DateTime    @default(now())

  results SubjectResult[]

  @@unique([subjectId, formClassId, termId])
  @@index([schoolId, termId])
  @@index([teacherId])
  @@map("subject_assignments")
}

/// A pupil's membership of a form class for a term.
model ClassEnrolment {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formClassId String
  formClass   FormClass @relation(fields: [formClassId], references: [id], onDelete: Cascade)
  termId      String
  term        Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  /// One form class per pupil per term.
  @@unique([studentId, termId])
  @@index([schoolId, formClassId, termId])
  @@map("class_enrolments")
}

/// A pupil's marks in one subject for one term.
model SubjectResult {
  id           String            @id @default(cuid())
  schoolId     String
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   SubjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  caScore         Float?
  examScore       Float?
  totalScore      Float?
  /// Derived from the school's scale — regenerated whenever the scale changes,
  /// exactly as on the degree side.
  letterGrade     String?
  gradePoint      Float?
  /// Rank within the form class for this subject. Competition ranking.
  positionInClass Int?
  /// Mean score across the class, for the "class average" column.
  classAverage    Float?
  remark          String?

  gradedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([studentId, assignmentId])
  @@index([schoolId, assignmentId])
  @@map("subject_results")
}

/// Daily attendance. K-12 requires it, and it feeds the promotion decision.
model AttendanceRecord {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId     String
  term       Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  date       DateTime
  /// AttendanceStatus: PRESENT | ABSENT | LATE | EXCUSED
  status     String
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@unique([studentId, date])
  @@index([schoolId, termId, date])
  @@map("attendance_records")
}

/// A termly report card.
///
/// Every figure on it is computed from the subject results rather than typed
/// in, and the lines are frozen at publication — it is a document handed to a
/// parent, so a reissued copy must match the one they already hold.
model ReportCard {
  id          String  @id @default(cuid())
  schoolId    String
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId      String
  term        Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  /// Human-quotable, e.g. "RPT-GIS-2025-000418".
  referenceNo String

  formClassCode   String
  totalMarks      Float
  maxMarks        Float
  average         Float
  classAverage    Float
  positionInClass Int
  classSize       Int
  overallGrade    String

  daysPresent Int @default(0)
  daysAbsent  Int @default(0)
  daysLate    Int @default(0)
  daysInTerm  Int @default(0)

  /// PromotionDecision: PROMOTED | REPEAT | REVIEW | GRADUATED | PENDING
  promotionDecision String  @default("PENDING")
  promotionReason   String?

  classTeacherRemark String?
  headTeacherRemark  String?
  /// Behaviour and skills ratings, 1-5, as a JSON object keyed by trait.
  traitsJson         String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines ReportCardLine[]

  @@unique([studentId, termId])
  @@unique([schoolId, referenceNo])
  @@index([schoolId, termId])
  @@map("report_cards")
}

/// A frozen snapshot of one subject row on a published report card.
model ReportCardLine {
  id           String     @id @default(cuid())
  schoolId     String
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)

  subjectCode     String
  subjectName     String
  caScore         Float?
  examScore       Float?
  totalScore      Float?
  letterGrade     String?
  classAverage    Float?
  positionInClass Int?
  remark          String?
  position        Int     @default(0)

  @@index([reportCardId])
  @@map("report_card_lines")
}

// -----------------------------------------------------------------------------
// Guardians
// -----------------------------------------------------------------------------

/// A parent or guardian.
///
/// Their own record rather than a field on the pupil, because a guardian may
/// have several children — possibly at more than one school — and duplicating
/// them per child is how contact details drift apart.
model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())

  children GuardianStudent[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@map("guardians")
}

/// Links a guardian to a pupil. A pupil may have several guardians; a guardian
/// may have several children.
model GuardianStudent {
  id             String   @id @default(cuid())
  schoolId       String
  guardianId     String
  guardian       Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Relationship: MOTHER | FATHER | GUARDIAN | OTHER
  relationship   String   @default("GUARDIAN")
  /// The contact the school calls first.
  isPrimary      Boolean  @default(false)
  /// Whether this guardian may see fees as well as academics.
  canViewFinance Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([guardianId, studentId])
  @@index([schoolId, studentId])
  @@map("guardian_students")
}

// =============================================================================
// SECTION 4 — COLLABORATION: TASKS AND NOTIFICATIONS (Phase 3)
// =============================================================================

/// A unit of assigned work.
///
/// Assignee and assigner are MEMBERSHIPS, not users. A task belongs to someone
/// in their capacity at one school: the professor who is a Dean at Golden
/// Eagles and a visiting lecturer at Meridian must not see one institution's
/// work in the other's queue, and keying on the user would do exactly that.
model Task {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title       String
  description String?

  /// TaskKind: COURSE_ASSIGNMENT | GRADE_SUBMISSION | DOCUMENT_REQUEST | ONBOARDING | MODERATION | ADMISSIONS_REVIEW | GENERAL
  kind String @default("GENERAL")
  /// TaskStatus: OPEN | IN_PROGRESS | BLOCKED | SUBMITTED | COMPLETED | CANCELLED
  status String @default("OPEN")
  /// TaskPriority: LOW | NORMAL | HIGH | URGENT
  priority String @default("NORMAL")

  /// Nullable so a task can outlive the membership it was assigned to — an
  /// unassigned task is a real state ("nobody is on this"), and cascading it
  /// away would erase the record that the work was ever asked for.
  assigneeId String?
  assignee   Membership? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignerId String?
  assigner   Membership? @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: SetNull)

  /// Optional scoping to a faculty, department or team.
  orgUnitId String?
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  /// What the task is ABOUT, as a loose reference rather than a foreign key:
  /// the subject may be a course offering, an application, an invoice or a
  /// forum post, and a nullable FK per kind would add a column per feature.
  /// The trade-off is explicit — no referential integrity on this pair, so
  /// readers must tolerate a dangling reference.
  subjectType String?
  subjectId   String?

  dueAt       DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  completedAt DateTime?
  /// Set once when the manager is notified, so escalation cannot repeat daily.
  escalatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments TaskComment[]
  events   TaskEvent[]
  watchers TaskWatcher[]

  @@index([schoolId, assigneeId, status])
  @@index([schoolId, status, dueAt])
  @@index([schoolId, subjectType, subjectId])
  @@map("tasks")
}

model TaskComment {
  id       String @id @default(cuid())
  schoolId String
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   Membership @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body     String

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

/// Append-only history. Never updated, never deleted while the task lives —
/// "who changed the due date, and when" is the question that gets asked when a
/// deadline is disputed, and it cannot be answered from current state.
model TaskEvent {
  id       String @id @default(cuid())
  schoolId String
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// TaskEventKind: CREATED | STATUS_CHANGED | REASSIGNED | DUE_DATE_CHANGED | PRIORITY_CHANGED | COMMENTED | ESCALATED
  kind String
  /// Null for a system-initiated event such as an automatic escalation.
  actorId String?
  actor   Membership? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  fromValue String?
  toValue   String?
  summary   String

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_events")
}

/// Someone following a task they neither own nor assigned.
model TaskWatcher {
  id       String @id @default(cuid())
  schoolId String
  taskId   String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, membershipId])
  @@index([membershipId])
  @@map("task_watchers")
}

/// An in-app notification for one membership.
///
/// Denormalised on purpose: `title`, `body` and `href` are copied at fan-out
/// rather than resolved at read time. A notification is a record of what was
/// said WHEN IT WAS SENT — re-deriving it later would silently rewrite history
/// as the underlying task changed, and would make the bell a fan of joins.
model Notification {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  /// NotificationKind: TASK_ASSIGNED | TASK_DUE_SOON | TASK_OVERDUE | TASK_ESCALATED | TASK_COMMENTED | TASK_COMPLETED | GRADES_POSTED | APPLICATION_DECIDED | INVOICE_ISSUED | ANNOUNCEMENT
  kind  String
  title String
  body  String?
  /// Where the bell sends them. Relative to the app root.
  href  String?

  subjectType String?
  subjectId   String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([membershipId, readAt, createdAt])
  @@index([schoolId, createdAt])
  @@map("notifications")
}

// =============================================================================
// SECTION 5 — FORUMS (Phase 4)
// =============================================================================

/// A discussion space.
///
/// `audience` is the load-bearing field: staff discuss a pupil's progress, a
/// disciplinary matter or a colleague's workload, and none of that may reach a
/// student-visible space. Every read path filters on it.
model Forum {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  description String?
  /// ForumAudience: STAFF | STUDENT | ALL
  audience    String  @default("STUDENT")
  /// Display order on the index; lower first.
  position    Int     @default(0)
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())

  categories ForumCategory[]
  threads    Thread[]

  @@unique([schoolId, slug])
  @@index([schoolId, audience])
  @@map("forums")
}

model ForumCategory {
  id       String @id @default(cuid())
  schoolId String
  forumId  String
  forum    Forum  @relation(fields: [forumId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  description String?
  position    Int     @default(0)

  threads Thread[]

  @@unique([forumId, slug])
  @@index([schoolId])
  @@map("forum_categories")
}

model Thread {
  id         String         @id @default(cuid())
  schoolId   String
  forumId    String
  forum      Forum          @relation(fields: [forumId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title String
  /// ThreadStatus: OPEN | LOCKED | HIDDEN | DELETED
  status String @default("OPEN")
  isPinned Boolean @default(false)

  /// Nullable so a thread survives the author's membership being removed.
  /// Deleting the discussion because somebody left would erase the answers
  /// everyone else contributed to it.
  authorId String?
  author   Membership? @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// Denormalised counters, maintained INSIDE the posting transaction — the
  /// same pattern as CourseOffering.seatsTaken. Source of truth remains the
  /// COUNT over posts; these exist so a forum index is one query, not N+1.
  postCount     Int       @default(0)
  reactionCount Int       @default(0)
  reportCount   Int       @default(0)
  viewCount     Int       @default(0)
  lastPostAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts   Post[]
  reports PostReport[]

  @@index([schoolId, forumId, status])
  @@index([forumId, isPinned, lastPostAt])
  @@map("threads")
}

model Post {
  id       String @id @default(cuid())
  schoolId String
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String?
  author   Membership? @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// The MARKDOWN SOURCE, never rendered HTML.
  ///
  /// Storing HTML would freeze today's renderer into the database: a fix to the
  /// sanitiser would not reach a single existing post, and every stored row
  /// would have to be trusted forever. Rendering on read means one code change
  /// protects the whole archive.
  body String

  /// The first post of a thread — the question itself, not a reply.
  isOpeningPost Boolean @default(false)

  reactionCount Int @default(0)
  reportCount   Int @default(0)

  /// Soft delete. A removed post leaves a tombstone so the replies quoting it
  /// still make sense to a reader.
  deletedAt DateTime?
  editedAt  DateTime?

  createdAt DateTime @default(now())

  reactions PostReaction[]
  reports   PostReport[]

  @@index([threadId, createdAt])
  @@index([schoolId, authorId, createdAt])
  @@map("posts")
}

model PostReaction {
  id       String @id @default(cuid())
  schoolId String
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  /// ReactionKind: LIKE | HELPFUL | AGREE
  kind String @default("LIKE")

  createdAt DateTime @default(now())

  /// One reaction per person per post — the database enforces it, so a
  /// double-clicked button cannot inflate a count.
  @@unique([postId, membershipId])
  @@index([schoolId])
  @@map("post_reactions")
}

model PostReport {
  id       String  @id @default(cuid())
  schoolId String
  postId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  reporterId String?
  reporter   Membership? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  /// ReportReason: SPAM | ABUSE | OFF_TOPIC | PERSONAL_DATA | ACADEMIC_DISHONESTY | OTHER
  reason  String
  detail  String?
  /// ReportStatus: PENDING | UPHELD | DISMISSED
  status  String  @default("PENDING")

  /// The moderation task raised for this report, so the queue and the task
  /// system are the same queue rather than two places to look.
  taskId String?

  resolvedById String?
  resolvedBy   Membership? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  resolution   String?

  createdAt DateTime @default(now())

  /// One report per person per post: a single objector cannot drive the
  /// auto-hide threshold on their own.
  @@unique([postId, reporterId])
  @@index([schoolId, status])
  @@map("post_reports")
}

// =============================================================================
// SECTION 6 — DIGITAL RESOURCE LIBRARY (Phase 5)
// =============================================================================
// Digital only, by an explicit product decision: no copies, no loans, no due
// dates, no reservations, no fines. That removes the entire circulation model —
// which is most of what makes a library system large — and leaves the part a
// school uses daily: finding material, and knowing whether anyone read it.

model LibraryResource {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  title       String
  /// Free text rather than a normalised Author table. A catalogue of this size
  /// gains nothing from the join, and "Axler, S." vs "Sheldon Axler" is a
  /// cataloguing problem no schema solves.
  authors     String  @default("")
  description String?
  /// ResourceKind: EBOOK | DOCUMENT | LINK | VIDEO | AUDIO | DATASET
  kind        String  @default("DOCUMENT")

  /// Where the material lives. Validated against the SAME scheme allowlist the
  /// forum renderer uses — a catalogue record is a stored, user-supplied URL
  /// rendered as a link in someone else's browser, which is the identical
  /// vector to a forum post.
  url         String
  /// Bibliographic extras, all optional — a school library is not MARC.
  publisher   String?
  isbn        String?
  edition     String?
  language    String  @default("en")
  pageCount   Int?
  /// Minutes, for video and audio.
  durationMin Int?

  /// Comma-separated, normalised lower-case. Stored denormalised because the
  /// filter sidebar is computed over the result set in memory, not queried.
  tags String @default("")

  // --- targeting -------------------------------------------------------------
  /// ResourceAudience: ALL | STAFF | STUDENT
  audience String @default("ALL")
  /// JSON arrays. EMPTY means "no restriction on this dimension", not "matches
  /// nothing" — so an unconfigured resource is visible to the school rather
  /// than invisible to everyone. Confidentiality is expressed by `audience`,
  /// which is a deliberate act rather than an omission.
  programIdsJson   String @default("[]")
  yearGroupIdsJson String @default("[]")
  levelsJson       String @default("[]")

  /// Denormalised counter, maintained inside the view transaction — the same
  /// pattern as CourseOffering.seatsTaken and Thread.postCount.
  viewCount Int @default(0)

  addedById String?
  addedBy   Membership? @relation("ResourceAdder", fields: [addedById], references: [id], onDelete: SetNull)

  /// Null while a draft; set when the resource goes live in the catalogue.
  publishedAt DateTime?
  isArchived  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  views       ResourceView[]
  collections ResourceCollectionItem[]

  @@index([schoolId, isArchived, publishedAt])
  @@index([schoolId, kind])
  @@map("library_resources")
}

/// A curated reading list: a module's set texts, a year group's recommended
/// reading, a department's core references.
model ResourceCollection {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  description String?
  /// ResourceAudience: ALL | STAFF | STUDENT
  audience    String  @default("ALL")

  curatorId String?
  curator   Membership? @relation("CollectionCurator", fields: [curatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  items ResourceCollectionItem[]

  @@unique([schoolId, slug])
  @@map("resource_collections")
}

model ResourceCollectionItem {
  id           String             @id @default(cuid())
  schoolId     String
  collectionId String
  collection   ResourceCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resourceId   String
  resource     LibraryResource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// The curator's note on why this item is on the list.
  note     String?
  position Int     @default(0)

  @@unique([collectionId, resourceId])
  @@index([schoolId])
  @@map("resource_collection_items")
}

/// One counted visit to a resource.
///
/// De-duplicated in the service by a 30-minute window per PERSON, so a refresh
/// or three open tabs is one read. Without that, a head of department deciding
/// whether to renew a subscription would be reading noise.
model ResourceView {
  id         String          @id @default(cuid())
  schoolId   String
  resourceId String
  resource   LibraryResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// Nullable so a view survives the reader's membership being removed — the
  /// usage history is what a renewal decision rests on, and losing it when
  /// somebody graduates would quietly rewrite the past.
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  viewedAt DateTime @default(now())

  @@index([resourceId, viewedAt])
  @@index([schoolId, membershipId, viewedAt])
  @@map("resource_views")
}

/// Attempts against the two endpoints reachable without an account.
///
/// PLATFORM-owned with a nullable `schoolId`: sign-in happens before a school
/// is known, and an attacker probing several schools should accumulate against
/// one address budget rather than getting a fresh one per tenant.
///
/// Durable rather than in-memory. An in-process counter resets on every deploy
/// and is per-instance, so it would be defeated by a restart and useless behind
/// more than one server — which is precisely when rate limiting starts to
/// matter.
model RateLimitHit {
  id       String  @id @default(cuid())
  schoolId String?

  /// What is being limited: "signin" | "apply".
  action String
  /// Normalised client address. Spoofable, so a spam-control key only —
  /// never identity. See normaliseAddress().
  address String
  /// The email or slug being acted on. Lower-cased.
  identifier String

  createdAt DateTime @default(now())

  @@index([action, identifier, createdAt])
  @@index([action, address, createdAt])
  @@index([createdAt])
  @@map("rate_limit_hits")
}
