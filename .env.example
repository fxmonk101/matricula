# =============================================================================
# ENVIRONMENT
# =============================================================================
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way —
# it carries the session signing key.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# LOCAL (SQLite):
#   DATABASE_URL="file:./dev.db?connection_limit=1&pool_timeout=30"
#
# PRODUCTION (Supabase Postgres). Supabase gives you two connection strings and
# BOTH are needed, for different reasons:
#
#   DATABASE_URL  — the POOLED connection (port 6543, via pgbouncer). Used by
#                   the running app. Serverless functions open a connection per
#                   invocation, and a direct connection per invocation exhausts
#                   Postgres' connection limit within minutes of real traffic.
#                   `pgbouncer=true` is required or Prisma's prepared statements
#                   break against the pooler.
#
#   DIRECT_URL    — the DIRECT connection (port 5432). Used ONLY by
#                   `prisma migrate`. Migrations issue DDL and advisory locks,
#                   which pgbouncer in transaction mode cannot carry.
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./dev.db?connection_limit=1&pool_timeout=30"

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# At least 32 characters. The app refuses to sign a session with a weaker key
# rather than doing it quietly.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Use a DIFFERENT value in production from the one on your laptop. Rotating it
# invalidates every live session, which is the point: it is what you do if a
# key is ever exposed.
AUTH_SECRET="change-me-to-at-least-32-random-characters"

# How long a signed-in session lasts. 8 hours by default — a working day.
SESSION_TTL_SECONDS=28800

# -----------------------------------------------------------------------------
# Tenancy
# -----------------------------------------------------------------------------
# How a request finds its school.
#   path       /s/<slug>/login        — the default, works anywhere
#   subdomain  <slug>.example.edu     — production, when DNS allows
TENANCY_MODE=path

# Only read in subdomain mode. The deployment's own domain, with no protocol.
# ROOT_DOMAIN=example.edu

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Where uploaded logos and documents are written. Local disk by default.
#
# NOTE FOR VERCEL: the filesystem there is read-only apart from /tmp, and /tmp
# does not survive between invocations. A deployment that accepts uploads needs
# an object-storage driver (Supabase Storage or S3) configured here — the
# interface for it is `src/server/storage/`.
# STORAGE_ROOT=./.storage
